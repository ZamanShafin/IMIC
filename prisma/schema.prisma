datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STAFF") // SUPER_ADMIN, STAFF, EDITOR, PATIENT
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handledBookings Booking[] @relation("StaffHandler")
  auditLogs       AuditLog[]
}

model Specialty {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  department  String
  icon        String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  procedures Procedure[]
  doctors    Doctor[]
  bookings   Booking[]
}

model Procedure {
  id          String    @id @default(uuid())
  specialtyId String
  name        String
  description String?
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  bookings    Booking[]
}

model Hospital {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  country       String   // Singapore, Malaysia, Thailand, India
  city          String
  address       String?
  description   String
  image         String
  photos        String   @default("[]") // JSON string of photo URLs
  accreditations String  @default("[]") // JSON string
  featured      Boolean  @default(true)
  createdAt     DateTime @default(now())

  doctors  Doctor[]
  bookings Booking[]
}

model Doctor {
  id           String    @id @default(uuid())
  name         String
  photo        String?
  title        String
  specialtyId  String?
  hospitalId   String
  bio          String?
  availability String?   @default("Mon-Fri")
  specialty    Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  hospital     Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bookings     Booking[]
}

model Booking {
  id                 String   @id @default(uuid())
  refNumber          String   @unique // IMIC-YYYYMMDD-XXXX
  patientName        String
  patientPhone       String
  patientEmail       String
  whatsappNumber     String?
  dob                String?
  gender             String?
  countryRes         String?  @default("Bangladesh")
  
  specialtyId        String?
  procedureId        String?
  country            String?  // Target country: Singapore, Malaysia, Thailand, India
  hospitalId         String?
  doctorId           String?
  
  preferredDateStart String?
  preferredDateEnd   String?
  notes              String?
  status             String   @default("PENDING") // PENDING, CONFIRMED, VISA_IN_PROGRESS, TRAVEL_SCHEDULED, ADMITTED, COMPLETED, CANCELLED
  
  staffHandlerId     String?
  staffNotes         String?
  
  specialty          Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  procedure          Procedure? @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  hospital           Hospital?  @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  doctor             Doctor?    @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  staffHandler       User?      @relation("StaffHandler", fields: [staffHandlerId], references: [id], onDelete: SetNull)
  
  documents          Document[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Document {
  id         String   @id @default(uuid())
  bookingId  String
  title      String
  fileName   String
  fileUrl    String
  uploadedBy String   @default("PATIENT") // PATIENT, STAFF
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model QuoteRequest {
  id          String   @id @default(uuid())
  name        String
  phone       String
  email       String
  country     String
  specialty   String
  timeframe   String?
  message     String
  reportUrl   String?
  status      String   @default("NEW") // NEW, IN_PROGRESS, RESOLVED
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  subject   String?
  message   String
  status    String   @default("NEW") // NEW, IN_PROGRESS, RESOLVED
  createdAt DateTime @default(now())
}

model Testimonial {
  id          String   @id @default(uuid())
  patientName String
  treatment   String
  hospital    String
  country     String
  quote       String
  photo       String?
  videoUrl    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  summary     String
  content     String
  coverImage  String
  author      String   @default("IMIC Medical Team")
  category    String   @default("Medical Tourism")
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model GalleryItem {
  id           String   @id @default(uuid())
  type         String   @default("PHOTO") // PHOTO, VIDEO
  title        String
  category     String   @default("General")
  url          String
  thumbnailUrl String?
  caption      String?
  createdAt    DateTime @default(now())
}

model TeamMember {
  id          String   @id @default(uuid())
  name        String
  designation String
  photo       String?
  bio         String?
  sortOrder   Int      @default(0)
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("General")
  sortOrder Int      @default(0)
}

model PartnerLogo {
  id        String  @id @default(uuid())
  name      String
  logoUrl   String
  website   String?
  sortOrder Int     @default(0)
}

model AccreditationLogo {
  id        String @id @default(uuid())
  name      String
  logoUrl   String
  sortOrder Int    @default(0)
}

model SiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
